import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Piece, PieceKind, BoardLine, Strand, Remote, DragRole, Beside } from "types.slint";
import { Icon, IconKind } from "icons.slint";
import { Grip, Landing } from "controls.slint";

// The name of a branch, as the pieces heading something write it.
component Name inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 700;
    vertical-alignment: center;
}

// What a piece holds, at its far end.
component Hint inherits Text {
    color: Theme.dim;
    font-size: 11px;
    vertical-alignment: center;
}

// Opens or closes what it is on: a card onto its files, a branch onto its
// commits.
component Fold inherits VerticalLayout {
    in property <bool> open;
    callback toggle();

    alignment: center;

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: area.has-hover ? Theme.hover : transparent;

        Icon {
            x: 4px;
            height: parent.height;
            kind: root.open ? IconKind.chevron-down : IconKind.chevron-right;
            ink: Theme.dim;
        }

        area := TouchArea {
            clicked => {
                root.toggle();
            }
        }
    }
}

// What a name or a file is tinted with when a drag can land on it, when it
// is selected, or under the pointer.
component Tint inherits Rectangle {
    in property <bool> selected;
    in property <bool> hovered;
    in property <DragRole> role;
    in property <bool> landing;

    border-radius: 5px;
    background: root.landing ? Theme.target-hover
        : root.role == DragRole.target ? Theme.target
        : root.selected ? Theme.selection
        : root.hovered ? Theme.hover
        : transparent;
}

// A piece of the board, drawn for what it is in the rectangle it was given:
// a name starts at its left edge.
component PieceVisual inherits Rectangle {
    in property <Piece> data;
    in property <bool> hovered;

    callback toggle();

    property <bool> onto: data.landing != "";

    // What a drag carries is lifted off the board.
    opacity: data.role == DragRole.source ? 0.55 : 1;

    // ── A commit: one line, its files under it once open ──
    if data.kind == PieceKind.card: Rectangle {
        border-radius: 6px;
        border-width: data.selected ? 2px : 1px;
        border-color: data.selected ? Theme.accent : root.hovered ? Theme.dim : Theme.border;
        background: root.onto ? Theme.card.mix(Theme.added, 0.7)
            : data.role == DragRole.target ? Theme.card.mix(Theme.added, 0.9)
            : Theme.card;

        HorizontalLayout {
            x: 0;
            y: 0;
            height: data.line;
            padding-left: 10px;
            padding-right: 5px;
            spacing: 10px;

            Text {
                text: data.sid;
                color: Theme.shortid;
                font-family: Theme.mono-family;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: data.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // In place of what it holds, which leaves its subject the room.
            if root.onto: VerticalLayout {
                alignment: center;

                Landing {
                    text: data.landing;
                }
            }
            if !root.onto: Hint {
                text: data.hint;
            }

            if data.expandable: Fold {
                open: data.expanded;
                toggle => {
                    root.toggle();
                }
            }
        }
    }

    // Clear of the name, which starts at the left edge.
    if data.kind == PieceKind.tag || data.kind == PieceKind.base: Tint {
        x: -6px;
        width: parent.width + 6px;
        selected: data.selected;
        hovered: root.hovered;
        role: data.role;
        landing: root.onto;
    }
    if data.kind == PieceKind.chip: Tint {
        x: 4px;
        width: parent.width - 8px;
        selected: data.selected;
        hovered: root.hovered;
        role: data.role;
        landing: root.onto;
    }

    // ── A branch name, heading its frame ──
    if data.kind == PieceKind.tag: HorizontalLayout {
        padding-right: 5px;
        spacing: 8px;

        Name {
            text: data.title;
            overflow: elide;
        }

        if data.remote != Remote.none: Icon {
            kind: data.remote == Remote.synced ? IconKind.check : data.remote == Remote.different ? IconKind.up : IconKind.cross;
            ink: data.remote == Remote.synced ? Theme.added : data.remote == Remote.different ? Theme.warn : Theme.removed;
        }
        Rectangle {
            horizontal-stretch: 1;
        }

        if root.onto: VerticalLayout {
            alignment: center;

            Landing {
                text: data.landing;
            }
        }
        if !root.onto: Hint {
            text: data.hint;
        }

        if data.expandable: Fold {
            open: data.expanded;
            toggle => {
                root.toggle();
            }
        }
    }

    // ── A file of an open commit ──
    if data.kind == PieceKind.chip: HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Text {
            width: 12px;
            text: data.status;
            color: Theme.added;
            font-family: Theme.mono-family;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: data.text;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    // ── The integration branch, heading its line ──
    if data.kind == PieceKind.tip: HorizontalLayout {
        Name {
            text: data.title;
            overflow: elide;
        }
    }

    // ── The upstream, and the commit the line stands on ──
    if data.kind == PieceKind.base: HorizontalLayout {
        spacing: 10px;

        Name {
            text: data.title;
        }

        Text {
            text: data.sid;
            color: Theme.dim;
            font-family: Theme.mono-family;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: data.text;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if data.hint != "": Hint {
            text: data.hint;
            color: Theme.warn;
        }
    }
}

// The board's pane: what `gui/board.rs` laid out, drawn where it put it.
export component BoardView inherits Rectangle {
    in property <[Piece]> pieces;
    in property <[BoardLine]> lines;
    in property <length> board-width;
    in property <length> board-height;
    // How wide the pane is, which the board is laid out to fill.
    out property <length> room: scroll.visible-width;
    // Where the board is scrolled to: the pane's top left corner shows
    // (-content-x, -content-y) of it.
    out property <length> content-x: scroll.content-x;
    out property <length> content-y: scroll.content-y;
    // A drag is going on, and where it would put a commit beside a card.
    in property <bool> dragging;
    in property <Beside> beside;

    callback resized(room: length);
    // The piece standing for `row` is to open, or to close.
    callback toggled(row: int);
    // The left button went down on the piece standing for `row`.
    callback pressed(row: int, control: bool, shift: bool);
    // The right button did, at `x`, `y` of the window.
    callback menu-asked(row: int, x: length, y: length);
    // The left button was let go on it, with no drag.
    callback released(row: int);
    // The pointer went off it with the button down, then dragged to `x`, `y`
    // of the window; the drag was let go, or taken away.
    callback lifted(row: int);
    callback dragged(x: length, y: length);
    callback dropped();
    callback drag-cancelled();
    // It scrolled, so what is under the pointer changed.
    callback scrolled();

    // Scroll by the turn of a wheel, as far as the board goes.
    public function scroll-by(dx: length, dy: length) {
        scroll.content-x = Math.max(scroll.visible-width - scroll.content-width, Math.min(0px, scroll.content-x + dx));
        scroll.content-y = Math.max(scroll.visible-height - scroll.content-height, Math.min(0px, scroll.content-y + dy));
    }

    // Scroll no further than it takes to show what lies from `y` down to
    // `y + h` of the board; what is taller than the pane, from its top.
    public function reveal(y: length, h: length) {
        if y < -scroll.content-y || h + 32px > scroll.visible-height {
            scroll.content-y = Math.max(scroll.visible-height - scroll.content-height, -Math.max(0px, y - 16px));
        } else if y + h > scroll.visible-height - scroll.content-y {
            scroll.content-y = Math.max(scroll.visible-height - scroll.content-height, scroll.visible-height - y - h - 16px);
        }
    }

    changed room => {
        root.resized(root.room);
    }
    changed content-x => {
        root.scrolled();
    }
    changed content-y => {
        root.scrolled();
    }

    background: Theme.board;
    clip: true;

    scroll := ScrollView {
        content-width: Math.max(root.board-width, self.visible-width);
        content-height: Math.max(root.board-height, self.visible-height);

        for line in root.lines: Rectangle {
            property <color> ink: line.color < 0 ? Theme.graph : Theme.dots[Math.mod(line.color, Theme.dots.length)];
            // What a node is set off against: a branch's are in its frame.
            property <color> ground: line.color < 0 ? Theme.board : Theme.frame;
            property <bool> frame: line.strand == Strand.frame;
            property <bool> ring: line.strand == Strand.ring;
            property <bool> node: self.ring || line.strand == Strand.bead;
            // A frame is round where its stack starts and ends.
            property <length> top-radius: self.frame ? (line.first ? 8px : 0) : line.w / 2;
            property <length> bottom-radius: self.frame ? (line.last ? 8px : 0) : line.w / 2;
            // Joined frames share the line between them.
            property <length> lap: self.frame && !line.first ? 1px : 0;

            x: line.x;
            y: line.y - self.lap;
            width: line.w;
            height: line.h + self.lap;
            border-top-left-radius: self.top-radius;
            border-top-right-radius: self.top-radius;
            border-bottom-right-radius: self.bottom-radius;
            border-bottom-left-radius: self.bottom-radius;
            border-width: self.frame ? 1px : self.ring ? 2.5px : self.node ? 2px : 0;
            border-color: self.frame ? Theme.border : self.ring ? self.ink : self.ground;
            background: self.frame ? Theme.frame : self.ring ? self.ground : self.ink;
        }

        // A file is placed after its card, so over it: it takes the pointer
        // there.
        for piece in root.pieces: Grip {
            x: piece.x;
            y: piece.y;
            width: piece.w;
            height: piece.h;
            dragging: root.dragging;

            press(control, shift) => {
                root.pressed(piece.row, control, shift);
            }
            release => {
                root.released(piece.row);
            }
            menu(x, y) => {
                root.menu-asked(piece.row, x, y);
            }
            lift => {
                root.lifted(piece.row);
            }
            drag(x, y) => {
                root.dragged(x, y);
            }
            drop => {
                root.dropped();
            }
            cancel => {
                root.drag-cancelled();
            }
            wheel(dx, dy) => {
                root.scroll-by(dx, dy);
            }
            // Not when the second press started a drag.
            double-clicked => {
                if !self.lifted {
                    root.toggled(piece.row);
                }
            }

            PieceVisual {
                data: piece;
                hovered: parent.has-hover && !root.dragging;
                toggle => {
                    root.toggled(piece.row);
                }
            }
        }

        // Over every piece: drawn with the card it is beside, the card
        // under it would cover it.
        if root.beside.shown: Rectangle {
            x: root.beside.x;
            y: root.beside.y;
            width: root.beside.w;
            height: root.beside.h;
            background: Theme.accent;

            Landing {
                x: parent.width - self.width - 8px;
                y: (parent.height - self.height) / 2;
                text: root.beside.label;
            }
        }
    }
}
