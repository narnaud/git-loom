import { Theme } from "theme.slint";
import { MenuEntry, TextRow } from "types.slint";
import { TextView } from "text.slint";
import { ToolButton } from "controls.slint";

// The inspector's pane: one piece, named, the commands of the selection,
// and the piece's diff.
export component InspectorView inherits Rectangle {
    // Empty with nothing to show.
    in property <string> title;
    in property <[MenuEntry]> actions;
    // A command runs: no other starts.
    in property <bool> busy;
    in property <[TextRow]> diff;
    // How many characters the longest line of the diff has.
    in property <int> columns;
    // What it says with nothing to show.
    in property <string> placeholder;

    // The command `id` was clicked.
    callback command(id: int);

    // Back to the top of the diff, for another piece's.
    public function to-top() {
        diff-view.to-start();
    }

    background: Theme.background;

    if root.title == "": Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    Rectangle {
        visible: root.title != "";

        VerticalLayout {
            Rectangle {
                height: 40px;
                background: Theme.panel;

                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: root.title;
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // As many columns of them as fit.
            if root.actions.length > 0: Rectangle {
                property <int> columns: Math.max(1, Math.floor((self.width - 20px) / 140px));
                property <length> cell: (self.width - 20px) / self.columns;

                height: Math.ceil(root.actions.length / self.columns) * 32px + 6px;
                background: Theme.panel;

                for action[i] in root.actions: ToolButton {
                    x: 10px + Math.mod(i, parent.columns) * parent.cell;
                    y: Math.floor(i / parent.columns) * 32px;
                    width: parent.cell - 6px;
                    outlined: true;
                    text: action.title;
                    enabled: action.enabled && !root.busy;
                    clicked => {
                        root.command(action.id);
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            diff-view := TextView {
                lines: root.diff;
                columns: root.columns;
            }
        }
    }
}
