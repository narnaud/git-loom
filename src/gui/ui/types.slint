// What a piece is to the drag going on; mirrors `drag::Role`.
export enum DragRole { none, source, target }

// The header of the local changes pane, which stands for them all.
export struct LocalChanges {
    // Index of its row in the tree, which every callback names it by; -1
    // while an operation is paused.
    row: int,
    // How many files there are.
    hint: string,
    selected: bool,
    role: DragRole,
    // What a drag let go over the pane does, while it is over it.
    landing: string,
}

// What a local change is; mirrors `graph::FileGroup`.
export enum ChangeKind { tracked, conflicted, untracked }

// A file of the local changes pane.
export struct ChangeRow {
    row: int,
    kind: ChangeKind,
    // Of a tracked file: the letter of its index, and of its working tree.
    staged: string,
    unstaged: string,
    path: string,
    selected: bool,
    role: DragRole,
}

// How a branch stands against its remote one; mirrors `RemoteStatus`.
export enum Remote { none, synced, different, gone }

// What a piece of the board stands for; mirrors `board::PieceKind`.
export enum PieceKind { tip, tag, card, chip, base }

// Something the board names, placed on it.
export struct Piece {
    kind: PieceKind,
    // Index of its row in the tree, which every callback names it by; -1
    // for the tip, which has none.
    row: int,
    x: length,
    y: length,
    w: length,
    h: length,
    // How high its own line is: an open card has its files under it.
    line: length,
    // The name of a branch: the integration one, a woven one, the upstream.
    title: string,
    // Of a commit: its short ID and its subject. The base has those of the
    // commit the integration branch stands on. Of a file: its path.
    sid: string,
    text: string,
    // What it holds: the commits of a branch, the files of a commit, the
    // commits new upstream.
    hint: string,
    // Of a file: the letter of what its commit does to it.
    status: string,
    remote: Remote,
    // Whether it opens: a card onto its files, a tag onto its commits.
    expandable: bool,
    expanded: bool,
    selected: bool,
    role: DragRole,
    // What a drag let go onto it does, while the pointer is on it.
    landing: string,
}

// The line saying where a commit dragged goes beside a card, and what it
// does there.
export struct Beside {
    shown: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
}

// What a line of the board draws; mirrors `board::LineKind`.
export enum Strand { thread, bead, ring, frame }

// Something the board draws without naming it.
export struct BoardLine {
    strand: Strand,
    x: length,
    y: length,
    w: length,
    h: length,
    // Index into `Theme.dots`; -1 for the integration line's own color.
    color: int,
    // Of a frame: whether it is the first, and the last, of its stack.
    first: bool,
    last: bool,
}

// What a line is: of a diff, as `session::diff_text::DiffLine` says, or of
// the log.
export enum TextKind { file-header, index, added, removed, hunk-header, context, commit-line, commit-header, command, success, warning, failure }

// A command as a menu, the inspector, the bar or the commit buttons offer
// it; `id` names it, -1 for the line between two groups of a menu.
export struct MenuEntry {
    id: int,
    title: string,
    // Whether the selection is something it takes.
    enabled: bool,
}

// How the status bar says something; mirrors `core::ui::Level`.
export enum Tone { plain, success, warn, error }

// An item of a dialog's list to pick from or tick, or a heading over some.
export struct Choice {
    text: string,
    heading: bool,
    checked: bool,
}

// What a dialog has typed in it, if anything; mirrors `forms::Input`.
export enum DialogInput { none, line, text }

// A question over the window, or what went wrong.
export struct Dialog {
    // The command asking.
    title: string,
    body: string,
    detail: string,
    // Why the last answer was refused.
    error: string,
    input: DialogInput,
    placeholder: string,
    choices: [Choice],
    // Whether any number of the choices are ticked, rather than one picked.
    multi: bool,
    // Where a commit can go.
    destinations: [string],
    confirm: string,
    cancellable: bool,
}

export struct TextRow {
    text: string,
    kind: TextKind,
}

// What the hunk picker is for, and how far the pick went.
export struct Picking {
    title: string,
    // How many hunks are kept, of how many.
    summary: string,
    confirm: string,
    // Why the last confirm was refused.
    error: string,
}

// A file of the hunk picker.
export struct HunkFile {
    kind: ChangeKind,
    // Of a tracked file: the letter of its index, and of its working tree;
    // of a commit's, what the commit does to it, then nothing.
    staged: string,
    unstaged: string,
    path: string,
    // Whether the pick keeps all its hunks, or some.
    checked: bool,
    mixed: bool,
}

// A line of the hunks of the file the picker shows: the first line of a
// hunk, which carries its box, or a line under it.
export struct HunkLine {
    text: string,
    kind: TextKind,
    // Index of its hunk in the file, which a click names.
    hunk: int,
    first: bool,
    kept: bool,
}
