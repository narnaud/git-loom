import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ChangeRow, ChangeKind, LocalChanges, DragRole, MenuEntry } from "types.slint";
import { Icon, IconKind } from "icons.slint";
import { Grip, Landing } from "controls.slint";

// The local changes pane: a header standing for all of them, then a line
// per file, then the buttons that take the ones selected, or the paused
// operation's.
export component ChangesView inherits Rectangle {
    in property <LocalChanges> local;
    in property <[ChangeRow]> changes;
    in property <[MenuEntry]> buttons;
    in property <bool> busy;
    // An operation is paused: the files listed are the ones it leaves.
    in property <bool> paused;
    in property <bool> dragging;

    // The left button went down on the line standing for `row`.
    callback pressed(row: int, control: bool, shift: bool);
    // The right button did, at `x`, `y` of the window.
    callback menu-asked(row: int, x: length, y: length);
    // The left button was let go on it, with no drag.
    callback released(row: int);
    callback double-clicked(row: int);
    // The pointer went off it with the button down, then dragged to `x`, `y`
    // of the window; the drag was let go, or taken away.
    callback lifted(row: int);
    callback dragged(x: length, y: length);
    callback dropped();
    callback drag-cancelled();
    // The wheel turned during a drag: the board scrolls.
    callback wheeled(dx: length, dy: length);
    // The command `id` of a button.
    callback command(id: int);

    property <length> line-height: 26px;

    // Scroll no further than it takes to show the file at `index`.
    public function reveal(index: int) {
        if index * root.line-height < -list.content-y {
            list.content-y = -index * root.line-height;
        } else if (index + 1) * root.line-height > list.visible-height - list.content-y {
            list.content-y = list.visible-height - (index + 1) * root.line-height;
        }
    }

    background: Theme.panel;

    VerticalLayout {
        Rectangle {
            height: 40px;
            background: root.local.landing != "" ? Theme.target-hover
                : root.local.role == DragRole.target ? Theme.target
                : root.local.selected ? Theme.selection
                : header.has-hover && !root.dragging ? Theme.hover
                : transparent;
            opacity: root.local.role == DragRole.source ? 0.55 : 1;

            header := Grip {
                // Nothing stands for the changes while an operation is paused.
                enabled: root.local.row >= 0;
                dragging: root.dragging;
                press(control, shift) => {
                    root.pressed(root.local.row, control, shift);
                }
                release => {
                    root.released(root.local.row);
                }
                menu(x, y) => {
                    root.menu-asked(root.local.row, x, y);
                }
                lift => {
                    root.lifted(root.local.row);
                }
                drag(x, y) => {
                    root.dragged(x, y);
                }
                drop => {
                    root.dropped();
                }
                cancel => {
                    root.drag-cancelled();
                }
                wheel(dx, dy) => {
                    root.wheeled(dx, dy);
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "Local changes";
                    color: Theme.text;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.local.landing != "": VerticalLayout {
                    alignment: center;

                    Landing {
                        text: root.local.landing;
                    }
                }
                if root.local.landing == "": Text {
                    text: root.local.hint;
                    color: Theme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.local.headline != "": Rectangle {
            background: Theme.selection;

            VerticalLayout {
                padding: 12px;

                Text {
                    text: root.local.headline;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }

        list := ListView {
            vertical-stretch: 1;

            for change in root.changes: area := Grip {
                height: root.line-height;
                // What a drag carries is lifted off the list.
                opacity: change.role == DragRole.source ? 0.55 : 1;
                dragging: root.dragging;
                press(control, shift) => {
                    root.pressed(change.row, control, shift);
                }
                release => {
                    root.released(change.row);
                }
                double-clicked => {
                    root.double-clicked(change.row);
                }
                menu(x, y) => {
                    root.menu-asked(change.row, x, y);
                }
                lift => {
                    root.lifted(change.row);
                }
                drag(x, y) => {
                    root.dragged(x, y);
                }
                drop => {
                    root.dropped();
                }
                cancel => {
                    root.drag-cancelled();
                }
                wheel(dx, dy) => {
                    root.wheeled(dx, dy);
                }

                Rectangle {
                    x: 4px;
                    width: parent.width - 8px;
                    border-radius: 5px;
                    background: change.selected ? Theme.selection : area.has-hover && !root.dragging ? Theme.hover : transparent;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 8px;

                    // The two status letters, or the mark standing for both.
                    Rectangle {
                        width: 18px;

                        // A letter each, side by side as `loom status` prints them.
                        if change.kind == ChangeKind.tracked: HorizontalLayout {
                            alignment: start;

                            Text {
                                width: 7px;
                                text: change.staged;
                                color: Theme.added;
                                font-family: Theme.mono-family;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 7px;
                                text: change.unstaged;
                                color: Theme.removed;
                                font-family: Theme.mono-family;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        if change.kind == ChangeKind.conflicted: Text {
                            text: "!!";
                            color: Theme.removed;
                            font-family: Theme.mono-family;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if change.kind == ChangeKind.untracked: Icon {
                            // Under the middle of two letters.
                            x: 1px;
                            kind: IconKind.asterisk;
                            ink: Theme.untracked;
                        }
                    }

                    Text {
                        text: change.path;
                        color: change.kind == ChangeKind.conflicted ? Theme.removed : Theme.text;
                        font-size: 12px;
                        font-weight: change.kind == ChangeKind.conflicted ? 700 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        if root.local.row >= 0 || root.paused: Rectangle {
            height: 1px;
            background: Theme.border;
        }
        if root.local.row >= 0 || root.paused: HorizontalLayout {
            vertical-stretch: 0;
            padding: 12px;
            spacing: 8px;
            alignment: end;

            for entry[index] in root.buttons: Button {
                text: entry.title;
                // The last, `Commit…` or `Continue`.
                primary: index == root.buttons.length - 1;
                enabled: entry.enabled && !root.busy;
                clicked => {
                    root.command(entry.id);
                }
            }
        }
    }
}
