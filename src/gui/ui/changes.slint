import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ChangeRow, ChangeKind, LocalChanges, MenuEntry } from "types.slint";
import { Icon, IconKind } from "icons.slint";

// The local changes pane: a header standing for all of them, then a line
// per file, then the buttons that take the ones selected.
export component ChangesView inherits Rectangle {
    in property <LocalChanges> local;
    in property <[ChangeRow]> changes;
    in property <[MenuEntry]> buttons;
    in property <bool> busy;

    // The left button went down on the line standing for `row`.
    callback pressed(row: int, control: bool, shift: bool);
    // The right button did, at `x`, `y` of the window.
    callback menu-asked(row: int, x: length, y: length);
    // The command `id` of a button.
    callback command(id: int);

    property <length> line-height: 26px;

    // Scroll no further than it takes to show the file at `index`.
    public function reveal(index: int) {
        if index * root.line-height < -list.content-y {
            list.content-y = -index * root.line-height;
        } else if (index + 1) * root.line-height > list.visible-height - list.content-y {
            list.content-y = list.visible-height - (index + 1) * root.line-height;
        }
    }

    background: Theme.panel;

    VerticalLayout {
        Rectangle {
            height: 40px;
            background: root.local.selected ? Theme.selection : header.has-hover ? Theme.hover : transparent;

            header := TouchArea {
                // Nothing stands for the changes while an operation is paused.
                enabled: root.local.row >= 0;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.pressed(root.local.row, event.modifiers.control, event.modifiers.shift);
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.menu-asked(root.local.row, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "Local changes";
                    color: Theme.text;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.local.hint;
                    color: Theme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        list := ListView {
            vertical-stretch: 1;

            for change in root.changes: area := TouchArea {
                height: root.line-height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.pressed(change.row, event.modifiers.control, event.modifiers.shift);
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.menu-asked(change.row, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }

                Rectangle {
                    x: 4px;
                    width: parent.width - 8px;
                    border-radius: 5px;
                    background: change.selected ? Theme.selection : area.has-hover ? Theme.hover : transparent;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 8px;

                    // The two status letters, or the mark standing for both.
                    Rectangle {
                        width: 18px;

                        // A letter each, side by side as `loom status` prints them.
                        if change.kind == ChangeKind.tracked: HorizontalLayout {
                            alignment: start;

                            Text {
                                width: 7px;
                                text: change.staged;
                                color: Theme.added;
                                font-family: Theme.mono-family;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 7px;
                                text: change.unstaged;
                                color: Theme.removed;
                                font-family: Theme.mono-family;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        if change.kind == ChangeKind.conflicted: Text {
                            text: "!!";
                            color: Theme.removed;
                            font-family: Theme.mono-family;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if change.kind == ChangeKind.untracked: Icon {
                            // Under the middle of two letters.
                            x: 1px;
                            kind: IconKind.asterisk;
                            ink: Theme.untracked;
                        }
                    }

                    Text {
                        text: change.path;
                        color: change.kind == ChangeKind.conflicted ? Theme.removed : Theme.text;
                        font-size: 12px;
                        font-weight: change.kind == ChangeKind.conflicted ? 700 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // None while an operation is paused.
        if root.local.row >= 0: Rectangle {
            height: 1px;
            background: Theme.border;
        }
        if root.local.row >= 0: HorizontalLayout {
            vertical-stretch: 0;
            padding: 12px;
            spacing: 8px;
            alignment: end;

            for entry[index] in root.buttons: Button {
                text: entry.title;
                // The last, `Commit…`.
                primary: index == root.buttons.length - 1;
                enabled: entry.enabled && !root.busy;
                clicked => {
                    root.command(entry.id);
                }
            }
        }
    }
}
