// The windows of git-loom-gui.

import { Button, Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    // The directory of the working tree.
    in property <string> repository;
    // The integration branch, or the operation paused on it.
    in property <string> heading;

    title: root.repository + " — git-loom";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 320px;
    background: Palette.background;

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: Palette.alternate-background;

            Text {
                x: 16px;
                height: parent.height;
                text: root.heading;
                color: Palette.foreground;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Rectangle { }
    }
}

// Why no window opened, for a program with no terminal to say it on.
export component ErrorWindow inherits Window {
    in property <string> message;
    callback dismissed();

    title: "git-loom";
    width: 460px;
    background: Palette.background;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: root.message;
            color: Palette.foreground;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dismissed();
                }
            }
        }
    }
}
