// The windows of git-loom-gui.

import { Button, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Piece, PieceKind, BoardLine, Strand, Remote } from "types.slint";
import { BoardView } from "board.slint";

export { Theme, Piece, PieceKind, BoardLine, Strand, Remote }

export component AppWindow inherits Window {
    // The directory of the working tree.
    in property <string> repository;
    // The integration branch, or the operation paused on it.
    in property <string> heading;

    // The board, which has nothing on it while an operation is paused.
    in property <[Piece]> pieces;
    in property <[BoardLine]> lines;
    in property <length> board-width;
    in property <length> board-height;

    callback board-resized(room: length);
    callback board-toggled(row: int);
    callback board-pressed(row: int, control: bool, shift: bool);
    // Whether the key was one of the window's.
    callback key-pressed(text: string) -> bool;

    public function reveal-on-board(y: length, h: length) {
        board.reveal(y, h);
    }

    title: root.repository + " — git-loom";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 320px;
    background: Theme.board;
    forward-focus: keys;

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: Theme.panel;

            Text {
                x: 16px;
                height: parent.height;
                text: root.heading;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        keys := FocusScope {
            key-pressed(event) => {
                root.key-pressed(event.text) ? accept : reject
            }

            board := BoardView {
                pieces: root.pieces;
                lines: root.lines;
                board-width: root.board-width;
                board-height: root.board-height;
                resized(room) => {
                    root.board-resized(room);
                }
                toggled(row) => {
                    root.board-toggled(row);
                }
                pressed(row, control, shift) => {
                    keys.focus();
                    root.board-pressed(row, control, shift);
                }
            }
        }
    }
}

// Why no window opened, for a program with no terminal to say it on.
export component ErrorWindow inherits Window {
    in property <string> message;
    callback dismissed();

    title: "git-loom";
    width: 460px;
    background: Palette.background;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: root.message;
            color: Palette.foreground;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dismissed();
                }
            }
        }
    }
}
